{
  "name": "foundry-voice-agent-teams-delegate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "dev": "concurrently -k \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@azure/communication-calling": "1.46.1",
    "@azure/communication-common": "2.5.0",
    "@azure/communication-identity": "1.3.1",
    "@azure/identity": "4.13.1",
    "express": "5.2.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.17",
    "@types/ws": "8.18.1",
    "concurrently": "9.2.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
