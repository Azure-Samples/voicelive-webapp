PORT=3000
NODE_ENV=development

# Use a connection string only on the backend. For production, store it as a
# Container Apps secret or Key Vault reference.
ACS_CONNECTION_STRING=endpoint=https://your-acs.communication.azure.com/;accesskey=replace-me

# Local development only. Production must supply an authenticated principal
# through Azure Container Apps or App Service built-in authentication.
DEV_USER_ID=local-developer

# One profile per executive. Each profile maps to one existing Foundry
# Voice-First Agent and an explicit allowlist of Entra object IDs.
EXECUTIVE_PROFILES_JSON=[{"id":"executive-1","displayName":"Executive delegate","projectEndpoint":"https://your-resource.services.ai.azure.com/api/projects/your-project","agentName":"executive-meeting-delegate","owner":"Executive","persona":"Represent the owner accurately. Speak only when addressed or when the meeting instructions require a contribution. Never invent private facts.","structuredInputsEnabled":true,"allowedUserIds":["local-developer"]}]

# Optional external Azure Functions service that owns guardrails, calendar,
# recap storage, and Web PubSub meeting controls. The key remains server-side.
MEETING_TOOLS_BASE_URL=https://your-function-app.azurewebsites.net
MEETING_TOOLS_FUNCTION_KEY=replace-me

# Optional Work IQ OBO integration. The client application needs delegated
# WorkIQAgent.Ask permission with tenant admin consent. Production callers
# send a user access token for this API in the Authorization header.
WORKIQ_TENANT_ID=00000000-0000-0000-0000-000000000000
WORKIQ_CLIENT_ID=00000000-0000-0000-0000-000000000000
WORKIQ_CLIENT_SECRET=replace-me

# Local development only. Never deploy a user token as an application setting.
WORKIQ_DEV_ACCESS_TOKEN=
